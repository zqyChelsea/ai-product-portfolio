# Replace placeholders only in your local .env or deployment secret store; never commit real keys.
PORT=4300
DATA_MODE=fixture
ALLOWED_ORIGIN=http://localhost:4300,https://zqychelsea.github.io

# OpenAI-compatible chat completions endpoint. Base URL should include /v1 if required by provider.
LLM_BASE_URL=xxxxx-url
LLM_API_KEY=xxxxx-api
LLM_MODEL=xxxxx-model

# Licensed supplier adapters. These are NORMALIZED gateway URLs, not assumed public Trip.com endpoints.
TRIP_BASE_URL=xxxxx-url
TRIP_API_KEY=xxxxx-api
TRANSIT_BASE_URL=xxxxx-url
TRANSIT_API_KEY=xxxxx-api

# Server-owned daily meal allowance, not a supplier quote. Override for your market.
MEALS_JPY_PER_DAY=3000
JPY_PER_HKD=xxxxx-rate
